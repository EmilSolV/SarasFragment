  m_EditorClassIdentifier: Assembly-CSharp::ButtonDialogSystem
  buttonDialogPairs:
  - button: {fileID: 1495636703}
    dialogText: "\xBFEmi? \xBFMi propia novia?"
    dialogDuration: 4
    isCorrectAnswer: 0
  - button: {fileID: 2088801474}
    dialogText: "\xBFAnabel? \xBFMi mejor amiga?"
    dialogDuration: 4
    isCorrectAnswer: 1
  winMessage: "\xA1No puedo creerlo, era ella! Ahora todo tiene sentido...\n\xA1HAS
    GANADO! Anabel era la culpable."
  loseMessage: "No... no tiene sentido. Las pistas no cuadran...\n\xA1HAS PERDIDO!
    Emi no era la culpable. Mejor suerte para la pr\xF3xima."
  resultMessageDuration: 8
  credits:
  - text: SARA'S FRAGMENT
    duration: 3
  - text: 'Un juego desarrollado por:'
